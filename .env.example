# ============================================================
# GamifyDeals – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Supabase: copy the "URI" from Database > Connection string
# For Railway/Neon: copy from dashboard
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/gamifydeals

# Set to "true" only if your cloud DB requires SSL (Supabase, Neon, Railway = true)
DATABASE_SSL=false

# Razorpay credentials — from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# JWT secret for admin sessions — use a long random string
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_long_random_string_here

# AES-256 key for encrypting Steam passwords — MUST be exactly 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_exactly_32_chars_here

# JWT secret for customer order view tokens (no expiry)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ORDER_TOKEN_SECRET=replace_with_another_long_random_string

# Server port (default: 3000)
PORT=3000

# Set to "production" when deploying live
NODE_ENV=development

# Your Razorpay webhook secret (from Razorpay Dashboard > Webhooks)
# Only needed if you configure webhooks
RAZORPAY_WEBHOOK_SECRET=
